# MES/MySQL integracija - primer konfiguracije.
# Kopiraj v .env (datoteka .env je v .gitignore - NIKOLI je ne commitaj)
# in vpiši prave vrednosti, ki jih dobiš od MES admina.

# --- Povezava na MES bazo (obvezno) ---
MES_DB_HOST=
MES_DB_PORT=3306
MES_DB_NAME=
# Priporočeno: read-only uporabnik za branje receptur
MES_DB_USER=
MES_DB_PASSWORD=

# --- Ločen uporabnik z write pravico za rezultate (opcijsko, least privilege) ---
# Če ni nastavljen, se za pisanje uporabi MES_DB_USER.
MES_DB_RESULTS_USER=
MES_DB_RESULTS_PASSWORD=

# --- Mapping MES stolpcev -> validator glave (opcijsko) ---
# Pot do JSON datoteke, ki prepiše privzeti profil (glej db/README.md).
MES_DB_MAPPING_FILE=

# --- Ostalo (opcijsko) ---
MES_DB_CHARSET=utf8mb4
MES_DB_CONNECT_TIMEOUT=10
# Pot do CA certifikata za TLS povezavo (prazno = brez TLS)
MES_DB_SSL_CA=

# --- Web plast ---
# 1 = vklopi endpointe /api/db/* v spletnem vmesniku (privzeto skriti)
MES_WEB_ENABLE_DB=0
